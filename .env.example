# Copier ce fichier en .env et renseigner les clés désirées.
# Le projet tourne sans aucune clé — OSM + heuristiques suffisent.

# Chemin de la base SQLite locale (relatif au répertoire de lancement)
# SQLITE_PATH=leadfinder.db

# -- Enrichissements optionnels (Phase 2) ------------------------------------

# PageSpeed Insights API — 25 000 req/jour, sans carte bancaire.
# https://developers.google.com/speed/docs/insights/v5/get-started
# PSI_API_KEY=

# Google Places API New — nécessite une carte + quotas Cloud bridés.
# Brider dans Cloud Console : Quota -> Places API -> Requests per month -> 4500 max
# pour rendre toute facturation impossible.
# GOOGLE_PLACES_API_KEY=

# Brave Search API — 2 000 req/mois gratuit, sans carte.
# https://api.search.brave.com/
# BRAVE_API_KEY=
