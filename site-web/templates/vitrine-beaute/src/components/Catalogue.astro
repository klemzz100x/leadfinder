---
import siteConfig from '../data/site.config.json';
import ImagePlaceholder from './ImagePlaceholder.astro';
---

<section id="catalogue" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <span class="text-rose-600 font-semibold uppercase tracking-widest text-sm">Catalogue</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-serif font-semibold text-stone-900">Nos produits</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {siteConfig.catalogue.map((produit, i) => (
        <div class="reveal bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg" style={`--reveal-index: ${i}`}>
          {produit.image ? (
            <img src={produit.image} alt={produit.nom} class="w-full h-48 object-cover" />
          ) : (
            <ImagePlaceholder label="Image à remplacer" class="w-full h-48" />
          )}
          <div class="p-5">
            <p class="font-semibold text-stone-900">{produit.nom}</p>
            <p class="mt-1 font-serif text-lg text-rose-600">{produit.prix}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
