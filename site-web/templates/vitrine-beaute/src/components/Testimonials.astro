---
import siteConfig from '../data/site.config.json';
---

<section id="avis" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <span class="text-rose-600 font-semibold uppercase tracking-widest text-sm">Avis clients</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-serif font-semibold text-stone-900">Ce qu'on dit de nous</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {siteConfig.avis.map((avis, i) => (
        <div class="reveal bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg" style={`--reveal-index: ${i}`}>
          <div class="text-amber-500 text-lg leading-none mb-3" aria-label={`Note : ${avis.note} sur 5`}>
            {'★'.repeat(Math.round(avis.note))}{'☆'.repeat(5 - Math.round(avis.note))}
          </div>
          <p class="text-stone-600 italic">"{avis.texte}"</p>
          <p class="mt-4 font-semibold text-stone-900">{avis.nom}</p>
        </div>
      ))}
    </div>
  </div>
</section>
