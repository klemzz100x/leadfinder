---
import siteConfig from '../data/site.config.json';
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-stone-200">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <span class="font-serif text-lg font-semibold text-stone-900">{siteConfig.nom}</span>
    <nav class="hidden sm:flex items-center gap-6 text-sm font-medium text-stone-600">
      <a href="/#prestations" class="hover:text-rose-600 transition-colors">Prestations</a>
      <a href="/catalogue" class="hover:text-rose-600 transition-colors">Catalogue</a>
      <a href="/#galerie" class="hover:text-rose-600 transition-colors">Galerie</a>
      <a href="/#avis" class="hover:text-rose-600 transition-colors">Avis</a>
      <a href="/#contact" class="hover:text-rose-600 transition-colors">Contact</a>
    </nav>
    <a
      href={`tel:${siteConfig.telephone}`}
      class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 transition-colors text-white text-sm font-semibold px-4 py-2 rounded-full"
    >
      📞 Appeler
    </a>
  </div>
</header>
