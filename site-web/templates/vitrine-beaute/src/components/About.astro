---
import siteConfig from '../data/site.config.json';
---

<section class="reveal max-w-4xl mx-auto px-6 py-20 text-center">
  <span class="text-rose-600 font-semibold uppercase tracking-widest text-sm">Bienvenue</span>
  <h2 class="mt-3 text-3xl sm:text-4xl font-serif font-semibold text-stone-900">
    À propos de {siteConfig.nom}
  </h2>
  <p class="mt-6 text-lg leading-relaxed text-stone-600">
    {siteConfig.description}
  </p>
</section>
