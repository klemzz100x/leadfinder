---
import siteConfig from '../data/site.config.json';
---

<section id="prestations" class="bg-stone-900 text-white py-20">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <span class="text-rose-400 font-semibold uppercase tracking-widest text-sm">Prestations</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-serif font-semibold">Nos tarifs</h2>
    </div>
    <ul class="divide-y divide-stone-700">
      {siteConfig.prestations.map((p, i) => (
        <li class="reveal flex items-center justify-between py-4" style={`--reveal-index: ${i}`}>
          <div>
            <p class="font-medium">{p.nom}</p>
            <p class="text-sm text-stone-400">{p.duree}</p>
          </div>
          <p class="font-serif text-xl text-rose-400">{p.prix}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
