---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Catalogue from '../components/Catalogue.astro';
import siteConfig from '../data/site.config.json';
---

<BaseLayout title={`Catalogue — ${siteConfig.nom}`}>
  <Nav />

  <div class="max-w-4xl mx-auto px-6 pt-16 pb-4 text-center">
    <a href="/" class="text-sm text-stone-500 hover:text-rose-600 transition-colors">← Retour à l'accueil</a>
  </div>

  <Catalogue />

  <footer class="bg-stone-900 text-stone-400 text-sm text-center py-6">
    © {new Date().getFullYear()} {siteConfig.nom} — Tous droits réservés
  </footer>
</BaseLayout>
